{
  "rules": {
    "anti-slop/no-chained-type-assertions": 1,
    "anti-slop/no-unknown-parameters": 5,
    "anti-slop/no-unknown-returns": 1,
    "anti-slop/no-unsafe-dictionary-type": 15,
    "anti-slop/require-safety-comment-for-type-assertion": 31,
    "eslint/max-params": 3,
    "typescript/no-redundant-type-constituents": 1,
    "typescript/unbound-method": 5
  },
  "oversizeFiles": {}
}
