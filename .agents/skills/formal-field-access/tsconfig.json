{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "composite": false,
    "noEmit": true
  },
  "include": ["*.ts", "*.mjs"]
}
